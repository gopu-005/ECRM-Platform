# ── Root .gitignore for ECRM Monorepo ──────────────────────────────────────

# ── Dependencies & Package Managers ───────────────────────────────────────
node_modules/
**/node_modules/
frontend/node_modules/
backend/node_modules/
.pnpm-store/
**/.pnpm-store/

# ── Python / Virtual Environments / Cache ─────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
*.venv
*.egg-info/
**/*.egg-info/
.eggs/
**/.eggs/
dist/
**/dist/
build/
**/build/
sdist/
wheels/

# ── Testing & Linting ──────────────────────────────────────────────────────
.pytest_cache/
**/.pytest_cache/
.coverage
**/.coverage
.coverage.*
htmlcov/
**/htmlcov/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# ── Celery & Logs ─────────────────────────────────────────────────────────
celerybeat-schedule*
celerybeat.pid
*.log
**/logs/
logs/
*.log.*

# ── Environment & Secrets ──────────────────────────────────────────────────
.env
**/.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── Build & Cache Outputs ──────────────────────────────────────────────────
.vite/
**/.vite/
.cache/
**/.cache/
.eslintcache
**/.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Databases & Storage Volumes ───────────────────────────────────────────
postgres_data/
**/postgres_data/
redis_data/
**/redis_data/
*.sqlite
*.sqlite3
*.db

# ── IDEs & Operating Systems ──────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
**/.idea/
*.swp
*.swo
*~
.DS_Store
**/.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── AI & Temporary Files ──────────────────────────────────────────────────
.gemini/
**/.gemini/
/tmp/
**/tmp/
