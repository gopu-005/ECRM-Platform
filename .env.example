# =============================================================================
# ECRM Platform — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars
APP_DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecrm_db
POSTGRES_USER=ecrm_user
POSTGRES_PASSWORD=ecrm_password
DATABASE_URL=postgresql+asyncpg://ecrm_user:ecrm_password@postgres:5432/ecrm_db
DATABASE_URL_SYNC=postgresql://ecrm_user:ecrm_password@postgres:5432/ecrm_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ecrm-platform.com

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=ECRM Platform

# ── PgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@ecrm.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_password

# ── Flower ────────────────────────────────────────────────────────────────────
FLOWER_BASIC_AUTH=admin:flower_password
